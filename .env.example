# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o .env — ele esta no .gitignore

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Usada apenas localmente / no Colab — nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Empire Play — Telegram (upload/streaming de vídeo)
# Token do bot criado no @BotFather (o mesmo bot deve ser admin do canal em TELEGRAM_CHAT_ID)
BOT_TOKEN=
# ID numérico do canal/chat do Telegram para onde os vídeos são publicados (ex: -1001234567890)
TELEGRAM_CHAT_ID=
# URL pública do seu servidor telegram-bot-api self-hosted (necessário para uploads >20MB e download sem limites)
# ex: http://SEU_IP_PUBLICO:8082
BOT_API_BASE_URL=

# Empire Play — vídeos legados (cadastrados antes da migração para a Bot API,
# identificados por ID de mensagem MTProto em vez de file_id da Bot API).
# URL pública do serviço legacy-telegram-proxy (ver pasta legacy-telegram-proxy/)
# ex: http://SEU_IP_PUBLICO:8083
LEGACY_TELEGRAM_PROXY_URL=
# ID numérico do canal antigo onde esses vídeos foram originalmente postados
LEGACY_TELEGRAM_CHANNEL_ID=

# Empire Play — Google Sheets/Drive (Service Account)
# Opção A: cole o JSON completo da chave da conta de serviço (Sheets API + Drive API habilitadas)
GOOGLE_SHEETS_CREDENTIALS=
# Opção B: informe os campos separadamente (usados se a opção A estiver vazia)
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
