{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "4abe95776fd846ab8a861101692d034f"
    }
  ],
  "vars": {
    // Atualize com a URL real depois do primeiro deploy do telegram-media no
    // Cloud Run (aparece nos logs do workflow "Deploy Telegram Media
    // Service" — algo como https://empire-telegram-media-XXXXX.a.run.app).
    "TELEGRAM_MEDIA_SERVICE_URL": "https://empire-telegram-media-PLACEHOLDER.a.run.app"
  }
}
