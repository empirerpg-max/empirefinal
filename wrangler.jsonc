{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "4abe95776fd846ab8a861101692d034f"
    }
  ],
  "vars": {
    "TELEGRAM_MEDIA_SERVICE_URL": "https://empire-telegram-media.onrender.com"
  },
  // Roda a cada 10 min — processa transmissões da Empire TV recém-encerradas
  // e grava a participação dos jogadores em REGISTRO (ver src/server.ts,
  // handler "scheduled").
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
