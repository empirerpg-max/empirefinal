{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "4abe95776fd846ab8a861101692d034f"
    }
  ],
  "vars": {
    "TELEGRAM_MEDIA_SERVICE_URL": "https://empire-telegram-media.onrender.com"
  },
  // Reativado (17/08): a conta de serviço já tem permissão de edição na aba
  // TV_Participacao_Processada, a transmissão de 12/08 foi marcada como
  // processada manualmente (evita duplicar o lote já gravado em REGISTRO) e
  // REGISTRO foi conferido sem duplicatas.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
